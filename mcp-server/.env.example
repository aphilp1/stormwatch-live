# StormWatch MCP server — environment variables (all optional)
#
# Claude Desktop does NOT auto-load this file. It documents the vars the server
# reads. To actually override a default, put these in the "env" block of your
# claude_desktop_config.json (see claude_desktop_config.example.json), or edit
# the defaults at the top of index.js.
#
# NEVER put a real email here in a committed copy — this repo is public.

# Path to the WindNinja CLI executable. If absent, WindNinja tools fail
# gracefully and everything else keeps working.
WINDNINJA_CLI=C:\WindNinja\WindNinja-3.12.2\bin\WindNinja_cli.exe

# Scratch directory for DEM tiles + WindNinja output (auto-created).
WINDNINJA_CACHE=C:\temp\windninja_cache

# Contact string placed in the NWS API User-Agent header. Placeholder only.
NWS_EMAIL=+https://github.com/aphilp1/stormwatch-live
